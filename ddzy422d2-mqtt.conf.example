# Exemple de fichier de configuration : python3 ddzy422d2-mqtt.py --config /etc/ddzy422d2-mqtt.conf
# Les clés sont les options de la ligne de commande sans « -- » ; la ligne de commande a la priorité sur ce fichier.
# Si le fichier contient un mot de passe : chmod 600 /etc/ddzy422d2-mqtt.conf
[ddzy422d2]
device = /dev/ttyUSB0
baud = 9600
parity = E
address = 1
# auto : s'intercale entre les échanges du module Wi-Fi s'il est présent ; non : pas de module, interrogation libre
module-wifi = auto

mqtt-host = 127.0.0.1
mqtt-port = 1883
# Connexion anonyme si mqtt-user est vide
mqtt-user =
mqtt-password =

prefix = homeassistant
# Noms (défaut : ddzy422d2 / Compteur DDZY422-D2 ; ddsu666h / Compteur DDSU666-H avec convention-ddsu)
#topic = ddzy422d2
#node = ddzy422d2
#name = Compteur DDZY422-D2
# Remplacement d'un DDSU666-H : mêmes entités, signes et réactive comme le DDSU (voir le README)
#convention-ddsu = oui
# kWh ajoutés aux énergies, pour reprendre les totaux du compteur remplacé
#decalage-import = 0
#decalage-export = 0
interval = 5
